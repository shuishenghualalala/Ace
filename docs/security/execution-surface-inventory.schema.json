{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ace.local/schemas/execution-surface-inventory.schema.json",
  "title": "Ace execution-surface inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "inventory_id",
    "summary_path",
    "surfaces"
  ],
  "properties": {
    "$schema": {
      "const": "./execution-surface-inventory.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "inventory_id": {
      "const": "ACE-EXECUTION-SURFACES"
    },
    "summary_path": {
      "const": "docs/security/execution-surface-inventory.md"
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "testReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[A-Z0-9][A-Z0-9._:-]+$"
        },
        "path": {
          "$ref": "#/$defs/repositoryPath"
        }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "enum": [
            "pytest",
            "node-test",
            "cargo-test",
            "ci-workflow",
            "static-analysis",
            "source-contract",
            "platform-attestation",
            "document"
          ]
        },
        "path": {
          "$ref": "#/$defs/repositoryPath"
        }
      }
    },
    "primitiveReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "primitive"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "kind": {
          "enum": [
            "python-network",
            "javascript-network",
            "rust-network",
            "python-file",
            "javascript-file",
            "rust-file",
            "javascript-browser",
            "javascript-ipc"
          ]
        },
        "primitive": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "categories",
        "path",
        "symbol_or_route",
        "owner",
        "trust_source",
        "final_enforcement_point",
        "fail_closed_behavior",
        "tests",
        "evidence",
        "artifact_refs",
        "lifecycle_revocation_owner",
        "status",
        "exception_expiry",
        "review_deadline",
        "review_trigger",
        "primitive_refs",
        "covered_routes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ACE-SURF-[A-Z0-9][A-Z0-9-]*$"
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "process-direct",
              "process-indirect",
              "network",
              "structured-file-read",
              "structured-file-write",
              "browser",
              "cdp",
              "upload",
              "download",
              "updater",
              "installer",
              "plugin",
              "skill",
              "cua",
              "mcp",
              "gateway-ipc",
              "gateway-route",
              "runtime-boundary",
              "dev-only"
            ]
          }
        },
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "symbol_or_route": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 3
        },
        "trust_source": {
          "type": "string",
          "minLength": 8
        },
        "final_enforcement_point": {
          "type": "string",
          "minLength": 8
        },
        "fail_closed_behavior": {
          "type": "string",
          "minLength": 8
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/testReference"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "artifact_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Repository-relative locators for the concrete test result, source contract, release artifact, or other evidence supporting this surface.",
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "lifecycle_revocation_owner": {
          "type": "string",
          "minLength": 3
        },
        "status": {
          "enum": [
            "enforced",
            "host-fixed",
            "sandbox-descendant",
            "fail-closed-unavailable",
            "dev-only",
            "tracked-exception"
          ]
        },
        "exception_expiry": {
          "description": "Null for ordinary surfaces; a tracked-exception must carry a non-null ISO date.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "review_deadline": {
          "type": "string",
          "format": "date",
          "description": "ISO calendar date by which this surface must be reviewed. When no external deadline exists, use a reasonable future date; this ledger uses 2027-12-31. The inventory tests reject dates before the current date."
        },
        "review_trigger": {
          "type": "string",
          "minLength": 8
        },
        "primitive_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/primitiveReference"
          }
        },
        "covered_routes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "route"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/repositoryPath"
              },
              "route": {
                "type": "string",
                "minLength": 3
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "tracked-exception"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exception_expiry": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "not": {
                  "const": "tracked-exception"
                }
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exception_expiry": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
