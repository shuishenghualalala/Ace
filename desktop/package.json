{
  "name": "crew-desktop-ui",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Crew Desktop UI",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:dev": "node esbuild.config.mjs --dev",
    "start": "npm run build && electron .",
    "dev": "npm run build:dev && electron . --dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm test && node scripts/check-security.mjs && npm run lint:css && node scripts/detect-duplicate-selectors.mjs --fail-on-different-value",
    "lint:css": "stylelint \"assets/styles/**/*.css\"",
    "test:visual": "playwright test --config=tests/visual/playwright.config.ts",
    "test:visual:update": "playwright test --config=tests/visual/playwright.config.ts --update-snapshots",
    "refactor:audit-leaks": "node scripts/audit-css-leaks.mjs",
    "refactor:extract-tokens": "node scripts/extract-theme-tokens.mjs",
    "refactor:audit-font-sizes": "node scripts/audit-font-sizes.mjs",
    "refactor:audit-dead-vars": "node scripts/audit-dead-css-vars.mjs",
    "refactor:detect-duplicates": "node scripts/detect-duplicate-selectors.mjs",
    "dist:linux": "npm run build && electron-builder --linux --config electron-builder.yml",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.yml"
  },
  "dependencies": {
    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.11",
    "jszip": "3.10.1",
    "katex": "^0.17.0",
    "mermaid": "^11.15.0",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "pinyin-pro": "^3.28.1",
    "pptx-svg": "0.6.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.0",
    "@types/node": "^20.10.6",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "happy-dom": "^20.10.6",
    "postcss": "^8.5.15",
    "stylelint": "^17.13.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@noble/hashes": "1.8.0",
    "brace-expansion@^5.0.0": "5.0.8"
  }
}
