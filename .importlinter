[importlinter]
root_package = crew

[importlinter:contract:core-feature-boundary]
name = Core must not depend on product features or host implementations
type = forbidden
source_modules =
    crew.core
forbidden_modules =
    crew.agent.external
    crew.gateway
    crew.team
    crew.wiki
allow_indirect_imports = True

[importlinter:contract:agent-team-boundary]
name = Agent must not add direct Team dependencies
type = forbidden
source_modules =
    crew.agent
forbidden_modules =
    crew.team
allow_indirect_imports = True
# 阶段 4A：中立化 External Agent Profile 后删除以下三项豁免。
ignore_imports =
    crew.agent.external.store -> crew.team.agent_profile
    crew.agent.external.store -> crew.team.capabilities
    crew.agent.external.store -> crew.team.roles

[importlinter:contract:agent-gateway-boundary]
name = Agent must not add direct Gateway dependencies
type = forbidden
source_modules =
    crew.agent
forbidden_modules =
    crew.gateway
allow_indirect_imports = True
# 阶段 2：引用注入已迁出；Session Context Contributor 落地后删除剩余豁免。
ignore_imports =
    crew.agent.runtime -> crew.gateway.session_context

[importlinter:contract:agent-wiki-boundary]
name = Agent must not add direct Wiki dependencies
type = forbidden
source_modules =
    crew.agent
forbidden_modules =
    crew.wiki
allow_indirect_imports = True
# 阶段 2：Wiki Attachment Contributor 落地后删除以下豁免。
ignore_imports =
    crew.agent.runtime -> crew.wiki.attachments

[importlinter:contract:external-agent-team-boundary]
name = External Agent must not add direct Team dependencies
type = forbidden
source_modules =
    crew.agent.external
forbidden_modules =
    crew.team
allow_indirect_imports = True
# 阶段 4A：External Agent Store 改用稳定契约后删除以下豁免。
ignore_imports =
    crew.agent.external.store -> crew.team.agent_profile
    crew.agent.external.store -> crew.team.capabilities
    crew.agent.external.store -> crew.team.roles

[importlinter:contract:security-feature-boundary]
name = Security must not depend on product features or hosts
type = forbidden
source_modules =
    crew.security
forbidden_modules =
    crew.agent.external
    crew.gateway
    crew.team
    crew.wiki
allow_indirect_imports = True
