[importlinter]
root_package = crew

[importlinter:contract:core-feature-boundary]
name = Core must not depend on product features or host implementations
type = forbidden
source_modules =
    crew.core
forbidden_modules =
    crew.agent.external
    crew.gateway
    crew.team
    crew.wiki
allow_indirect_imports = True

[importlinter:contract:agent-team-boundary]
name = Agent must not add direct Team dependencies
type = forbidden
source_modules =
    crew.agent
forbidden_modules =
    crew.team
allow_indirect_imports = True

[importlinter:contract:agent-gateway-boundary]
name = Agent must not add direct Gateway dependencies
type = forbidden
source_modules =
    crew.agent
forbidden_modules =
    crew.gateway
allow_indirect_imports = True

[importlinter:contract:agent-wiki-boundary]
name = Agent must not add direct Wiki dependencies
type = forbidden
source_modules =
    crew.agent
forbidden_modules =
    crew.wiki
allow_indirect_imports = True

[importlinter:contract:external-agent-team-boundary]
name = External Agent must not add direct Team dependencies
type = forbidden
source_modules =
    crew.agent.external
forbidden_modules =
    crew.team
allow_indirect_imports = True

[importlinter:contract:security-feature-boundary]
name = Security must not depend on product features or hosts
type = forbidden
source_modules =
    crew.security
forbidden_modules =
    crew.agent.external
    crew.gateway
    crew.team
    crew.wiki
allow_indirect_imports = True

[importlinter:contract:state-wiki-boundary]
name = State must not add direct Feature package dependencies
type = forbidden
source_modules =
    crew.state
forbidden_modules =
    crew.wiki
    crew.team
    crew.agent.external
allow_indirect_imports = True
