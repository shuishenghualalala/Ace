# 复制为项目根目录的 .env 后填写。

# 默认模型的 API Key，对应 config.yaml 中 default profile 的 api_key_env。
CREW_MODEL_API_KEY=

# 本地 OpenAI 兼容服务如需鉴权可填写；不需要鉴权时可留空。
LOCAL_LLM_API_KEY=

# 可选：启动时选择哪个模型配置，对应 config.yaml 的 llm.models key。
# 不填则使用 config.yaml 里的 llm.active。
# CREW_MODEL_PROFILE=default

# 以下 CREW_* 覆盖项仅用于旧式单模型 default 配置；多模型配置优先使用 config.yaml。
# CREW_BASE_URL=
# CREW_MODEL=gpt-4o-mini
# CREW_TEMPERATURE=0.7
# CREW_MAX_TOKENS=4096
# CREW_CONTEXT_WINDOW=128000
# CREW_TIMEOUT=60

# 可选：反馈服务。未配置时反馈页面会提示服务未配置，不会发起外部请求。
# CREW_FEEDBACK_BASE_URL=https://feedback.example.com

# 可选：远程认证服务地址。仅在 config.yaml 的 auth.mode 为 remote 时启用。
# CREW_AUTH_BASE_URL=https://auth.example.com

# 可选：LLM Wiki 图片理解。服务需兼容 OpenAI Chat Completions 的 image_url 输入。
# VLM_BASE_URL=https://your-model-service.example/v1
# VLM_MODEL=your-vision-model
# VLM_API_KEY=
# VLM_TIMEOUT_SECONDS=120

# 可选：LLM Wiki 视频理解。视频会上传到这里配置的外部服务，调用前需要用户确认。
# VLM_VIDEO_UPLOAD_URL=https://your-media-service.example/upload
# VLM_VIDEO_ANALYZE_URL=https://your-media-service.example/analyze
# VLM_VIDEO_MODEL=your-video-model

# 可选：日志级别 DEBUG/INFO/WARNING
CREW_LOG_LEVEL=INFO

# 可选：日志文件路径，空则不写文件（覆盖 config.yaml 的 runtime.log_file）
# CREW_LOG_FILE=~/.crew/logs/crew.log
