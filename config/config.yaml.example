llm:
  active: default   # 兼容字段；建议与 default 保持一致
  default: default  # 新会话与辅助推理的默认兜底模型
  models:
    default:
      name: Default
      api_key_env: CREW_MODEL_API_KEY
      base_url: https://api.example.com/v1
      model: your-model-name
      vision: false
      temperature: 0.7
      max_tokens: 40960
      context_window: 256000
      timeout: 60
      # Browser Use 的 DOM/snapshot 路径不依赖视觉；仅在该网关模型已验证
      # 支持图片输入后，才由管理员显式追加 vision。
      capabilities: [text, tools]
runtime:
  crew_home: .Crew
  db_path: crew_data/crew.db
  # 内置记忆默认关闭：SQLiteMemory 的关键词朴素召回是 demo 级，召回差比没有更
  # 伤观感。需要跨会话记忆时改为 true 显式开启，或接入 MCP memory server。
  memory_enabled: false
  log_level: INFO
  log_file: logs/crew.log
  llm_trace: false
  max_iterations: 0
  # 外部 Runtime 统一超时策略。hard_timeout_seconds: 0 表示不设硬截止；
  # 缺省时保持各协议现有兼容默认（ACP 仍为 idle×4 或 idle+900）。
  timeout_policy:
    external_idle_seconds: 120
    interactive_idle_floor_seconds: 330
    interaction_timeout_seconds: 300
    binding_grace_seconds: 30
    # hard_timeout_seconds: 0
  sqlite_wal: true
  # 单工具执行看门狗（秒）：单个工具的执行段（不含权限等待）超过 N 秒后取消该工具，
  # 合成 "timed out after X.Xs" 作为正常 tool output 回给模型——tool_call/tool output
  # 历史配对完整，回合继续推进，不会被一个挂死的工具冻结。0 = 关闭看门狗。
  # 用户点「停止」时另有 interrupt 取消语义（优雅窗口后强取消，输出 aborted by user）。
  tool_execution_timeout_seconds: 600
  # 整回合 deadline（秒）：回合累计时长上限。到点走与 interrupt 相同的优雅收尾
  # （中断标记 + 回合正常结束，历史/输出含 "deadline exceeded" 标记），在途工具
  # 走 aborted 语义；0 = 不限（默认关闭）。
  turn_deadline_seconds: 0
  # 追问/权限确认等待上限（秒）：wait_for_answer 调用方未显式传 timeout 时的默认
  # 有界等待；超时按「用户未回答」收尾（返回空答案），追问工具与权限确认共用。
  # 0 = 默认不限（维持旧的不限语义）。显式传 timeout（含 None/0）始终优先。
  interaction_timeout_seconds: 3600
  # 独立线程 health 服务端口（桌面端优先探测，业务事件循环卡超时仍能感知进程
  # 活性）。0 表示自动（gateway 端口 + 1）；显式配置（如 8010）则覆盖默认值。
  health_port: 0
agent:
  executor: builtin
  parallel_tools: true
  max_parallel_tool_calls: 8
  compaction:
    enabled: true
    token_budget: 0
    token_budget_ratio: 0.75
    keep_recent: 8
    keep_recent_tools: 6
    l2_incremental: true
    l2_delta_threshold: 5000
    post_compact_files: 3                    # 压缩后恢复最近 N 个文件（按 path 去重，从磁盘重读）
    post_compact_max_chars_per_file: 5000    # 单个恢复文件最大字符数
    post_compact_max_instructions: 5         # 压缩后最多恢复的指令条数
    post_compact_max_important: 8            # 压缩后最多恢复的重要结论条数
    post_compact_max_instruction_chars: 20000
    post_compact_max_important_chars: 5000
    post_compact_max_total_chars: 140000     # 恢复附件总字符闸口
  retry:
    max_retries: 3
    backoff_seconds: 1.0
  stream_resilience:
    read_timeout: 300
    continuation_max: 3
    retry_jitter: true
    stale_timeout: 0
  title:
    auto: true
  client:
    module: ''
  acp:
    command: ''
    args: []
  evolution:
    auto_trigger: false       # 每轮交互结束后自动触发 evolution 轨迹提取
    auto_full_cycle: false   # 执行完整周期：优化+生成（设为 false 则仅提取轨迹）
    visible: false          # 后台静默执行（设为 true 则前台输出状态帧，同步等待）
gateway:
  host: 127.0.0.1
  port: 8000
  dev_mode: false
  dev_account: dev:dev
  admin_accounts: []
  max_active_runs: 4
  max_queue_depth_per_session: 20
# 安全模块总开关。false 表示默认使用当前宿主用户的完全访问权限，不启用沙箱和审批。
security:
  enabled: false
# 默认使用邮箱区分本机租户（不验证邮箱所有权）。local 为免登录，remote 为验证码登录。
auth:
  mode: email  # local | email | remote
  remote:
    provider_id: custom
    # 占位地址不会被请求；请改成自己的认证服务，或用 CREW_AUTH_BASE_URL 覆盖。
    base_url: https://xxxxx.example
    send_code_path: /auth/send-code
    login_path: /auth/login-by-code
    timeout_seconds: 10
    session_ttl_seconds: 604800
tools:
  # web_search 引擎配置（纯 API provider，无 HTML 刮取）。providers 为显式有序
  # fallback 列表（按序逐个降级，全败时返回结构化错误与已尝试链路）；
  # 留空 = 默认链（全部可用 provider 按注册序，exa → bocha → searxng）。
  # 一个都不可用时工具直接报错，引导用户完成下列配置。
  # exa：需 EXA_API_KEY（或 exa_api_key_env 指定的环境变量）；exa_base_url 默认
  # https://api.exa.ai；
  # bocha：博查 AI 搜索，需 BOCHA_API_KEY（或 bocha_api_key_env 指定的环境变量）；
  # searxng：需可公网到达的实例地址（SSRF 防护不允许私网主机）。
  web_search:
    providers: []
    exa_api_key_env: EXA_API_KEY
    exa_base_url: ""
    bocha_api_key_env: BOCHA_API_KEY
    searxng_base_url: ""
  # 大结果落盘阈值：工具结果字符数超过此值时，完整内容写入
  # {CREW_HOME}/tool-results/{tool_call_id}.txt，模型只收「路径 + 头尾预览 + 截断标记」。
  # 默认阈值为 50000 字符。
  max_result_size_chars: 50000
  permissions: []
  tool_search:
    # off：关闭 progressive disclosure，全部工具按原样暴露给 LLM（bridge 工具不注入）。
    # on：默认全部工具常驻，仅 deferred_toolsets 中的 cron/Wiki 工具按需经 tool_search 加载。
    # 工具搜索只在 access_control 已允许的当前会话范围内进行，不会扩大权限。
    enabled: "on"
    search_default_limit: 5
    max_search_limit: 20
    core_toolsets:
    - "*"
    deferred_toolsets:
    - cron
    - wiki.read
    - wiki.manage
  file:
    read_max_chars: 100000
    # read-before-edit 观察策略：true 时 patch/file_write 要求当前会话先 file_read
    # 过目标文件（观察到的版本同时作为写入 CAS 基），未读即拒并提示补救动作。
    require_read_before_edit: false
  terminal:
    max_timeout: 600
plugins:
  enabled:
  - security_guidance
  - crew_disk_cleanup
  - feishu
  - weixin
  disabled:
mcp_servers:
  cua-driver:
    command: cua-driver
    args:
    - mcp
    env: {}
    auto_connect: false
access_control:
  user_type: internal
  external:
    prompt_profile: "external"
    enabled_toolsets: ["*"]
    disabled_toolsets: ["mcp:cua-driver"]
    enabled_tools: ["*"]
    disabled_tools: []
    enabled_plugins:
    - '*'
    disabled_plugins: []
    enabled_skills:
    - '*'
    disabled_skills: ["browser-use"]   # browser-use skill 依赖内置浏览器；external 的 browser toolset 已在 disabled_toolsets 里禁用，避免展示无法使用的“死 skill”

# 进程内 HTTP 边界（web_search/web_extract/Wiki 抓取）的上游代理。
# 安全意味着“经过策略判断”，判断通过后把流量级联到用户已有的上游代理，
# 而不是强制直连。留空时回退到环境变量
# HTTP_PROXY / HTTPS_PROXY / ALL_PROXY（大小写都读）。
# 能直连外网的服务器留空即可；需要代理的开发机设 HTTPS_PROXY 即可，
# 也可在此直接填，如 http://127.0.0.1:7890 或 socks5h://127.0.0.1:7890。
network:
  # 上游代理地址。支持 http:// https:// socks5:// socks5h://，可带 user:pass@。
  # 留空 = 读环境变量（推荐，跨环境零配置）。
  upstream_proxy: ""
  # 是否允许代理本身监听在 127.0.0.1/::1（本地 Clash 等场景）。
  allow_loopback_proxy: true

# ============================================================================
# features.*：Feature 配置的规范命名空间（P2-1 第二步起为模板唯一布局）。
#
# 约定：每个 Feature 只读自己的 features.<name> 子树，子键结构与旧顶层节
# 逐字兼容（features.wiki 的内容 = 旧 wiki: 节的内容）。历史上平铺的
# runtime.dk_* 键对应 features.dynamic_kanban（子键去掉 dk_ 前缀）；
# tools.browser 对应 features.browser。
# 兼容性：手工编辑的旧配置（顶层 wiki/cron/team/tasks/external_agents/
# channels/platforms、tools.browser、runtime.dk_*）仍可正常读取——同名键
# features 侧获胜、未在 features 出现的键回落旧节；但产品不再生成这些旧
# 位置，运行时写回统一落在 features.channels。
# 注意：数据库路径（runtime.<feature>_db_path）由 core 装配层统一消费注入，
# 属基础设施配置，不进 features.*。
# ============================================================================
features:
  wiki:
    # 聊天中上传的附件是否自动收入 default 知识库。
    # true（默认）：保存原文件并解析成 markdown，并自动生成轻量摘要/标签；
    # 深度整理（生成 entity/topic/relationship）默认不自动执行，需要用户确认。
    capture_attachments: true
    ingest:
      # 是否在深度整理计划生成成功后自动应用计划。
      # true：capture → parse → orient → plan → apply 同一轮完成，不展示确认卡。
      # false（默认）：plan 后展示创建/更新/跳过计划并等待用户确认，后续回合再 apply。
      # 该配置只影响实体/概念/主题/关系的深度整理；删除、归档、视频外传仍必须人工确认。
      auto_apply: false
      # 捕获后是否自动生成轻量摘要、标签和是否建议整理的标记（第二层）。
      auto_summarize: true
      # 捕获后是否自动深度整理（第三层）。默认关闭，避免自动把临时文件写入知识库。
      auto_ingest: false
    # Wiki 数据独立存储目录。留空时保持现状：
    # {runtime.crew_home}/accounts/{owner_hash}/wiki_lib/。
    # 也可通过 CREW_WIKI_HOME 环境变量覆盖。
    storage:
      root: ""
    # Wiki 提取可选用独立的、适合稳定结构化输出的模型。
    # 可填 llm.models 下的 profile key；留空时跟随当前会话模型，
    # 无会话上下文时回退当前账号的默认模型。
    model: ""
  cron:
    enabled: true
    max_parallel_jobs: 2
  team:
    max_concurrent_children: 3
    members:
    - name: researcher
      role: 负责查资料、读取文件、搜集与整理信息
    - name: coder
      role: 负责编写代码、执行命令、文件读写等工程操作
  # 子 agent（delegate_task / run_agent）的超时在 tasks.subagent 配置；
  # 顶层 subagent: 节从未被 loader 读取（历史死配置），已移除。
  tasks:
    auto_background_after_seconds: 15
    heartbeat_interval_seconds: 10
    monitor_interval_seconds: 5
    wait_timeout_seconds: 30
    finished_retention_days: 7
    shell:
      inactivity_timeout_seconds: 600
      execution_timeout_seconds: 0
    # 子 agent（delegate_task / run_agent）长任务超时：
    # 空闲 N 秒零输出中止；绝对运行上限兜底。0 表示不限。
    subagent:
      inactivity_timeout_seconds: 120
      execution_timeout_seconds: 1800
    agent_turn:
      inactivity_timeout_seconds: 600
      execution_timeout_seconds: 3600
  # 外部智能体与外部 Team 的产品入口开关。关闭时仅隐藏/禁用，历史数据仍保留。
  external_agents:
    enabled: true
    # true: 外援经过 Ace native runtime；false: 外援按旧 runtime 直联。
    # 默认 false；该开关不影响内建工具的会话安全边界。
    security_enabled: false
  # 各通道配置按通道名作为子键；运行时写回也统一落在此处。
  channels: {}
  browser:
    enabled: true
    runtime: electron
    display: in_app
    # 不创建独立浏览器窗口；页面需要展示时挂载到 Crew 的 WebContentsView 面板。
    headed: false
    idle_timeout_seconds: 600
    command_timeout_seconds: 30
    navigation_timeout_seconds: 60
    queue_timeout_seconds: 30
    max_output_chars: 30000
    max_transfer_bytes: 104857600
    artifact_ttl_hours: 24
    # 动作治理档位：
    # - off：全部放行，不弹任何审批
    # - confirm_sensitive：默认。提交表单/回车/上传/下载/接受弹窗/页面内执行代码等
    #   传「或高危」动作在桌面端弹一次性审批卡（allow once）；普通读写动作不打扰
    # - confirm_writes：所有写交互（click/type/press/select/check/drag/fill_form/drop）都弹审批
    # - read_only：写交互与高危动作直接拒绝
    governance_mode: confirm_sensitive
    allowed_private_hosts: []
    allowed_private_cidrs: []
    blocked_hosts: []
    allow_file_urls: false
  # dynamic-kanban 历史上平铺在 runtime.dk_*，目标形态为独立子树
  # （task_timeout_seconds / verification_gate_enabled）。
  dynamic_kanban:
    task_timeout_seconds: 3600
    verification_gate_enabled: true
